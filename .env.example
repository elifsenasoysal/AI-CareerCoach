# ─────────────────────────────────────────────────────────────────────────────
# AI Kariyer Koçu — Ortam Değişkenleri Şablonu
#
# Bu dosyayı kopyalayıp ".env" olarak kaydet:
#   cp .env.example .env
#
# .env dosyası .gitignore'a eklenmiştir — gerçek değerleri oraya yaz.
# Bu şablon dosyasına (env.example) asla gerçek/gizli değer yazma.
# ─────────────────────────────────────────────────────────────────────────────


# ── Ollama / LLM ─────────────────────────────────────────────────────────────
# Ollama sunucusunun adresi
# Lokal geliştirme için varsayılan: http://localhost:11434
# Docker Compose kullanıyorsan: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

# Kullanılacak model adı (Ollama'ya pull edilmiş olmalı)
# Örnekler: llama3, llama3:8b, mistral, phi3
LLM_MODEL=llama3

# LLM isteği için zaman aşımı süresi (saniye)
LLM_TIMEOUT=60.0


# ── Redis (Opsiyonel) ────────────────────────────────────────────────────────
# Şu an SessionCache in-memory dict kullanıyor.
# Redis'e geçmek istersen bu URL'i ayarla ve cache.py backend'ini güncelle.
REDIS_URL=redis://localhost:6379
# PostgreSQL / Local Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_career_coach_db
DB_USER=postgres
DB_PASSWORD=KENDI_SIFREN
DB_SSLMODE=disable

DATABASE_URL=postgresql://postgres:KENDI_SIFREN@localhost:5432/VERITABANI_ADIN